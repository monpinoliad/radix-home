# Optional: copy to calendar.env (git-ignored) to show today's events from Home Assistant.
# The board reaches Home Assistant over plain HTTP on the local network.

# Home Assistant's local address (not a Tailscale/remote one: the board can't reach those).
HA_HOST="192.168.1.10"
HA_PORT="8123"
# Long-lived access token: HA profile -> Security -> Long-lived access tokens.
HA_TOKEN=""
# Calendar entity IDs whose events to show, comma-separated.
HA_CALENDARS="calendar.family"
# Optional: calendar whose events say which bins to put out (by colour word or 🔴🟢🟡 in the
# title). Without it, the schedule in src/bins.rs is used.
HA_BIN_CALENDAR=""
# Optional: media player for the now-playing slide (e.g. Spotify), shown while it plays.
HA_MEDIA_PLAYER=""
